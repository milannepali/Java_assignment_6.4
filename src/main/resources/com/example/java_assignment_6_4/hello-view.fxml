<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="500.0" prefWidth="500.0" spacing="10.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/27.0.1.1" fx:controller="com.example.java_assignment_6_4.NoteController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <Label text="Note Title" />
      <TextField fx:id="titleField" promptText="Enter note title" />
      <Label text="Note Content" />
      <TextArea fx:id="contentArea" prefHeight="120.0" prefWidth="200.0" promptText="Write your note here..." />
      <Button mnemonicParsing="false" onAction="#addNote" text="Add" />
      <Label text="Saved Notes" />
      <TextArea fx:id="savedNotesArea" prefHeight="130.0" prefWidth="200.0" promptText="Your saved notes will appear here" />
   </children>
</VBox>
